__pycache__/
*.pyc
.venv/
.streamlit/
# Tool state
.coverage
.hypothesis/
.benchmarks/
.pytest_cache/
.ruff_cache/
# Release data lives ONLY at repo-root data/ (anchored: bare `data/` would
# silently exclude src/brain_tumor/data, configs/data, tests/data).
/data/
kaggle/codepkg/
# Kaggle kernel-output download scratch (redundant artifact copies; logs are
# 0-byte under the CLI's charmap bug — fetch logs via the API with PYTHONUTF8=1).
kaggle/kaggle-output*/
kaggle/bt-major-code-snapshot/
# Smoke runs and non-production checkpoints stay local (precedent: last.pt
# remains on kernels; smoke dirs are pipeline checks, not releases).
*-smoke/
last.pt
# Checkpoints: exclude all EXCEPT the three SB-1 production best.pt files,
# which ride via Git LFS (see .gitattributes). (*.pt first, negations after —
# last match wins, so exceptions must come last.)
*.pt
checkpoints/*
!checkpoints/CLS-001/
!checkpoints/SEG-001/
!checkpoints/ROB-001/
checkpoints/CLS-001/*
!checkpoints/CLS-001/best.pt
checkpoints/SEG-001/*
!checkpoints/SEG-001/best.pt
checkpoints/ROB-001/*
!checkpoints/ROB-001/best.pt
# Evidence outputs (small JSON/MD/PNG) ARE part of SB-1 and are committed.

